{
  "name": "@elizabthpazp/intera-ui",
  "version": "1.2.1",
  "description": "Una colección de componentes reutilizables en React",
  "keywords": [
    "react",
    "components",
    "UI"
  ],
  "author": "elijs.dev",
  "license": "MIT",
  "module": "dist/components/index.js",
  "types": "dist/components/index.d.ts",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "build": "babel src --out-dir dist --extensions .js,.jsx && npx tsc src/components/index.js --declaration --allowJs --emitDeclarationOnly --outDir dist --moduleResolution node --target ES2017 --jsx preserve --esModuleInterop --skipLibCheck --lib dom,dom.iterable,esnext",
    "postbuild": "postcss src/globals.css -o dist/globals.css && postcss src/globals.isolated.css -o dist/globals.isolated.css --config postcss.library.config.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "framer-motion": ">=6.0.0",
    "lucide-react": ">=0.300.0",
    "next": ">=13.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "babel-plugin-file-loader": "^2.0.0",
    "babel-plugin-transform-assets": "^1.0.2",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "main": "dist/components/index.js",
  "sideEffects": [
    "*.css",
    "dist/globals.css",
    "src/globals.css"
  ],
  "files": [
    "dist",
    "dist/**/*.d.ts",
    "src/globals.css"
  ]
}
